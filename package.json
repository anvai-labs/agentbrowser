{
  "name": "agentbrowser-monorepo",
  "version": "1.9.1",
  "private": true,
  "description": "AgentBrowser: Agent-First Headless Browser",
  "scripts": {
    "release:sync": "node scripts/sync-versions.mjs --write",
    "release:check": "node scripts/sync-versions.mjs",
    "release:artifacts": "node scripts/check-release-artifacts.mjs",
    "spec:context": "node scripts/spec-context.mjs",
    "test:release": "node --test scripts/sync-versions.test.mjs",
    "test:probes": "node --test scripts/worker-inheritance.test.mjs scripts/child-cdp.test.mjs scripts/worker-network.test.mjs scripts/worker-startup.test.mjs scripts/startup-cleanup.test.mjs scripts/raw-cdp.test.mjs scripts/owner-release.test.mjs scripts/sole-owner.test.mjs",
    "build": "pnpm -r --filter './packages/**' build",
    "build:apps": "pnpm -r --filter './apps/**' build",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter './packages/**' test",
    "test:e2e": "pnpm --filter './tests/**' test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "ci": "pnpm build && pnpm type-check && pnpm test",
    "bench": "pnpm --filter @agentbrowser/benchmarks all",
    "bench:real": "pnpm --filter @agentbrowser/benchmarks bench:real",
    "test:coexistence": "node scripts/check-coexistence.mjs",
    "test:coexistence-victor": "node scripts/check-victor-coexistence.mjs",
    "firefox:install": "node packages/engine-firefox/scripts/install.mjs",
    "test:firefox": "node scripts/check-firefox.mjs",
    "test:firefox-independence": "node scripts/check-firefox-independence.mjs",
    "probe:firefox-egress": "node packages/engine-firefox/scripts/probe-egress.mjs",
    "test:egress-evidence": "node --test scripts/browser-egress-gate.test.mjs scripts/bidi-probe-connection.test.mjs scripts/service-worker-probe.test.mjs",
    "probe:firefox-session-egress": "node packages/engine-firefox/scripts/probe-session-egress.mjs",
    "test:application-independence": "node scripts/check-application-independence.mjs",
    "test:job-eligibility": "tsc --noEmit --allowJs --checkJs --module NodeNext --target ES2022 --skipLibCheck examples/job-application/eligibility.mjs && tsc --noEmit --allowJs --module NodeNext --target ES2022 --skipLibCheck examples/job-application/listing-review.mjs && node --test scripts/job-eligibility.test.mjs scripts/job-listing-review.test.mjs"
  },
  "keywords": ["browser", "automation", "agent", "headless", "playwright"],
  "author": "AgentBrowser Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}

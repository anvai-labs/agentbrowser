{
  "name": "@agentbrowser/mcp-server",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing AgentBrowser as high-level, safe, composable tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentbrowser-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "compile": "node scripts/compile.mjs",
    "smoke": "node scripts/smoke.mjs dist-bin/agentbrowser-mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist dist-bin *.tsbuildinfo"
  },
  "dependencies": {
    "@agentbrowser/protocol": "workspace:*",
    "@agentbrowser/sdk-typescript": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}

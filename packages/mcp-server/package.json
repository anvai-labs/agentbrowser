{
  "name": "@anvailabs/agentbrowser-mcp",
  "version": "1.27.3",
  "type": "module",
  "description": "MCP server exposing AgentBrowser as high-level, safe, composable tools (talks to an AgentBrowser service via AGENTBROWSER_BASE_URL)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentbrowser-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc && esbuild dist/bin.js --bundle --platform=node --format=esm --outfile=dist/bin.bundled.js && mv dist/bin.bundled.js dist/bin.js && esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/index.bundled.js && mv dist/index.bundled.js dist/index.js",
    "type-check": "tsc --noEmit",
    "compile": "node scripts/compile.mjs",
    "smoke": "node scripts/smoke.mjs dist-bin/agentbrowser-mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist dist-bin *.tsbuildinfo",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@agentbrowser/core": "workspace:^",
    "@agentbrowser/engagement": "workspace:*",
    "@agentbrowser/protocol": "workspace:*",
    "@agentbrowser/sdk-typescript": "workspace:*",
    "@biomejs/biome": "^2.5.15",
    "@sinclair/typebox": "^0.34.16",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvai-labs/agentbrowser.git",
    "directory": "packages/mcp-server"
  },
  "license": "Apache-2.0"
}

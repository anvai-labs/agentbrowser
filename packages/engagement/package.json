{
  "name": "@agentbrowser/engagement",
  "version": "1.26.0",
  "description": "T10: findings bound to an engagement ledger, checked offline and exported as a SARIF draft (no DOM or image dependencies)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@agentbrowser/core": "workspace:*",
    "@agentbrowser/policy": "workspace:*"
  }
}

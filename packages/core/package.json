{
  "name": "@agentbrowser/core",
  "version": "1.29.0",
  "private": true,
  "description": "Core session management, action execution, and observation normalization",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentbrowser/engine": "workspace:*",
    "@agentbrowser/protocol": "workspace:*",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./private-file": {
      "types": "./dist/private-file.d.ts",
      "import": "./dist/private-file.js"
    },
    "./local-artifacts": {
      "types": "./dist/local-artifacts.d.ts",
      "import": "./dist/local-artifacts.js"
    }
  }
}

    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentbrowser/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}

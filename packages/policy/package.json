{
  "name": "@agentbrowser/policy",
  "version": "1.27.3",
  "private": true,
  "type": "module",
  "description": "Network policy enforcement for SSRF defense and safety",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",

{
  "name": "@agentbrowser/benchmarks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness, deterministic agent task suite, and soak tests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist *.tsbuildinfo",
    "bench": "node dist/run.js bench",
    "tasks": "node dist/run.js tasks",
    "soak": "node dist/run.js soak",
    "all": "node dist/run.js all"
  },
  "dependencies": {
    "@agentbrowser/api": "workspace:*",
    "@agentbrowser/core": "workspace:*",
    "@agentbrowser/engine": "workspace:*",
    "@agentbrowser/protocol": "workspace:*",
    "@agentbrowser/testkit": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}

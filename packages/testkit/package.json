{
  "name": "@agentbrowser/testkit",
  "version": "1.0.0",
  "private": true,
  "description": "Testing utilities, fake engine, and contract test suite",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",

{
  "name": "@agentbrowser/api",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API server for AgentBrowser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist *.tsbuildinfo",
    "openapi": "node dist/emit-openapi.js"
  },
  "dependencies": {
    "@agentbrowser/control": "workspace:*",
    "@agentbrowser/core": "workspace:*",
    "@agentbrowser/engine": "workspace:*",
    "@agentbrowser/engine-playwright": "workspace:^",
    "@agentbrowser/engine-safari": "workspace:*",
    "@agentbrowser/extraction": "workspace:^",
    "@agentbrowser/policy": "workspace:^",
    "@agentbrowser/protocol": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@agentbrowser/testkit": "workspace:^",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "agentbrowser-server": "dist/bin.js"
  }
}

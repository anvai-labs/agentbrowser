{
  "name": "@agentbrowser/engine-obscura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Obscura engine adapter: binary acquisition, process lifecycle, and a BrowserEngine composing the CDP path",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist *.tsbuildinfo",
    "fetch": "node scripts/fetch.mjs"
  },
  "dependencies": {
    "@agentbrowser/engine": "workspace:*",
    "@agentbrowser/engine-playwright": "workspace:*"
  },
  "devDependencies": {
    "@agentbrowser/testkit": "workspace:*",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}

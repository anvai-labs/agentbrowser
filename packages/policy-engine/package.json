{
  "name": "@agentbrowser/policy-engine",
  "version": "1.17.1",
  "private": true,
  "type": "module",
  "description": "Server policy decisions behind one Authorizer seam (ADR-024)",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentbrowser/core": "workspace:*",
    "@agentbrowser/policy": "workspace:*",
    "@agentbrowser/protocol": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  }
}

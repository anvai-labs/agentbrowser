#!/usr/bin/env bash
# Pre-commit hook for TDD compliance for AgentBrowser
# Run this script before committing to ensure TDD methodology is followed

set -e

echo "🔍 Running AgentBrowser TDD pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# 1. Type check
echo ""
echo "1️⃣  Type checking all packages..."
if pnpm -r type-check; then
    print_success "Type checking passed"
else
    print_error "Type checking failed. Fix TypeScript errors before committing."
    echo "Run: pnpm -r type-check"
    exit 1
fi

# 2. Linting and formatting
echo ""
echo "2️⃣  Checking code formatting and linting..."
if pnpm -r lint; then
    print_success "Code is properly formatted and linted"
else
    print_error "Linting issues found. Run: pnpm -r lint (or biome)"
    exit 1
fi

# 3. Build check
echo ""
echo "3️⃣  Building all packages..."
if pnpm -r build; then
    print_success "All packages build successfully"
else
    print_error "Build failed. Fix build errors before committing."
    echo "Run: pnpm -r build"
    exit 1
fi

# 4. Unit tests
echo ""
echo "4️⃣  Running unit tests..."
if pnpm -r test; then
    print_success "Unit tests passed"
else
    print_error "Unit tests failed. Fix them before committing."
    echo "Run: pnpm -r test"
    exit 1
fi

# 5. Check for TODO/FIXME in new code
echo ""
echo "5️⃣  Checking for temporary markers in staged files..."
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ts$' || true)
if [ -n "$STAGED_TS_FILES" ]; then
    TODO_COUNT=0
    for file in $STAGED_TS_FILES; do
        if [ -f "$file" ]; then
            TODO_IN_FILE=$(git diff --cached "$file" | grep -E "^\+.*TODO|FIXME|HACK|XXX" | wc -l)
            TODO_COUNT=$((TODO_COUNT + TODO_IN_FILE))
        fi
    done

    if [ "$TODO_COUNT" -gt 0 ]; then
        print_warning "Found $TODO_COUNT TODO/FIXME markers in staged code"
        echo "Consider addressing them before committing"
    else
        print_success "No TODO/FIXME markers in staged code"
    fi
else
    print_success "No TypeScript files staged"
fi

# All checks passed
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ All TDD pre-commit checks passed!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "Ready to commit! 🚀"
